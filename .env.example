# Copy this file to .env.local for local development; never commit real credentials.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
APP_BASE_URL=http://localhost:3000
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
# Server-only values must be configured in your deployment secret manager, not here:
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# LOVABLE_CRON_SECRET=
# APP_USER_CONNECTION_KEY_SECRET=
# GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=
# AUTOSTUDIO_OUTBOUND_TRANSPORT_READY=false  # Set true only after a deployed Node-runtime smoke test.
# AUTOSTUDIO_DURABLE_QUEUE_ENABLED=false  # Controls new durable queue producers; enable only after staging acceptance.
# AUTOSTUDIO_DURABLE_QUEUE_WORKER_ENABLED=false  # Controls job consumption; enable separately after authenticated empty-queue smoke test.
